{
  "name": "@ambulance/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "node prisma/prepare-db.js && prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node prisma/prepare-db.js && prisma migrate reset --force && npm run db:seed",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "zod": "^4.1.12",
    "@prisma/adapter-better-sqlite3": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
