{
  "name": "ambulance-dispatch-system",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Academic demonstration of ambulance dispatch and hospital coordination.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:reset": "npm run db:reset -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
